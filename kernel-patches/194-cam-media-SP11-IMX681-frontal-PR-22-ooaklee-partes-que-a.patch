+static const struct ccs_imx681_mode *
+ccs_imx681_current_mode(const struct ccs_sensor *sensor)
+{
+	if (!ccs_is_imx681(sensor))
+		return NULL;
+
+	/* The 3844x2640 mode is the only mode validated on the SP11 C-PHY. */
+	return &imx681_mode;
+}
