drm/msm/dpu: keep vblank enabled when entering self refresh (SP11, 18-10-2026)

--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c	2026-10-18 11:20:28.881808740 +0200
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c	2026-10-18 11:20:28.873167816 +0200
@@ -1212,8 +1212,13 @@
 		return;
 	}
 
-	/* Disable/save vblank irq handling */
-	drm_crtc_vblank_off(crtc);
+	/*
+	 * Disable/save vblank irq handling, unless we are entering self
+	 * refresh: the DRM core expects vblank to stay enabled then and
+	 * warns ("driver disabled vblank in self-refresh") otherwise.
+	 */
+	if (!crtc->state->self_refresh_active)
+		drm_crtc_vblank_off(crtc);
 
 	drm_for_each_encoder_mask(encoder, crtc->dev,
 				  old_crtc_state->encoder_mask) {
