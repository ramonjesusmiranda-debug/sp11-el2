From 515daf435a6af7480e22913fdc6623b4d86ec1bd Mon Sep 17 00:00:00 2001
From: Anthony Ruhier <aruhier@mailbox.org>
Date: Tue, 20 Oct 2026 17:50:09 +0200
Subject: [PATCH] drm/msm/dpu: lower the core clock on runtime suspend

The MDSS wrapper keeps DISP_CC_MDSS_MDP_CLK enabled for as long as one
of its interfaces is active, e.g. an eDP controller holding its link
while the panel is in PSR. The DPU performance state vote goes away
with the DPU runtime PM state, but the clock is left at the last rate:
on X1E it keeps running at 575 MHz (NOM_L1) while MMCX drops to SVS,
voted by the DP controller alone.

Drop the core clock to its lowest OPP on runtime suspend, and restore
the last rate set by dpu_core_perf on resume, since a later commit only
updates the clock when the computed rate changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556eb6ecc2..3f524353f0904 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1437,6 +1437,20 @@ static int __maybe_unused dpu_runtime_suspend(struct device *dev)
 	struct platform_device *pdev = to_platform_device(dev);
 	struct msm_drm_private *priv = platform_get_drvdata(pdev);
 	struct dpu_kms *dpu_kms = to_dpu_kms(priv->kms);
+	unsigned long min_freq = 0;
+	struct dev_pm_opp *opp;
+
+	/*
+	 * The MDSS keeps the core clock enabled while any of its interfaces
+	 * is active (e.g. eDP in PSR), but the performance state vote goes
+	 * away with this device: don't leave the clock above what the rail
+	 * supports. dpu_runtime_resume() restores the rate.
+	 */
+	opp = dev_pm_opp_find_freq_ceil(dev, &min_freq);
+	if (!IS_ERR(opp)) {
+		dev_pm_opp_put(opp);
+		dev_pm_opp_set_rate(dev, min_freq);
+	}
 
 	clk_bulk_disable_unprepare(dpu_kms->num_clocks, dpu_kms->clocks);
 
@@ -1457,6 +1471,8 @@ static int __maybe_unused dpu_runtime_resume(struct device *dev)
 
 	ddev = dpu_kms->dev;
 
+	dev_pm_opp_set_rate(dev, dpu_kms->perf.core_clk_rate ?: dpu_kms->perf.max_core_clk_rate);
+
 	rc = clk_bulk_prepare_enable(dpu_kms->num_clocks, dpu_kms->clocks);
 	if (rc) {
 		DPU_ERROR("clock enable failed rc:%d\n", rc);
