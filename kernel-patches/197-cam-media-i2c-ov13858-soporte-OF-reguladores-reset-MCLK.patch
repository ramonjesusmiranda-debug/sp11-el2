From a3ad46ae7855e15eb22de90ffc4b4aa3174a4196 Mon Sep 17 00:00:00 2001
From: Ramón Jesús Miranda <ramonjesusmiranda@gmail.com>
Date: Sat, 24 Oct 2026 15:44:04 +0000
Subject: [PATCH 197/197] media: i2c: ov13858: OF support (regulators, reset, MCLK)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 drivers/media/i2c/ov13858.c | 133 +++++++++++++++++++++++++++++++++++-
 1 file changed, 130 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/ov13858.c b/drivers/media/i2c/ov13858.c
index 09d58e8b1..de8b51dea 100644
--- a/drivers/media/i2c/ov13858.c
+++ b/drivers/media/i2c/ov13858.c
@@ -3,9 +3,12 @@
 
 #include <linux/acpi.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-event.h>
@@ -1028,9 +1031,17 @@ static const struct ov13858_mode supported_modes[] = {
 	}
 };
 
+static const char * const ov13858_supply_names[] = {
+	"dovdd",	/* Digital I/O power */
+	"avdd",		/* Analog power */
+	"dvdd",		/* Digital core power */
+};
+
 struct ov13858 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(ov13858_supply_names)];
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -1052,6 +1063,97 @@ struct ov13858 {
 
 #define to_ov13858(_sd)	container_of(_sd, struct ov13858, sd)
 
+static int ov13858_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13858 *ov13858 = to_ov13858(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov13858_supply_names),
+				    ov13858->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable regulators\n");
+		return ret;
+	}
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(ov13858->clk);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable clock\n");
+		goto disable_regulators;
+	}
+
+	gpiod_set_value_cansleep(ov13858->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+disable_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(ov13858_supply_names),
+			       ov13858->supplies);
+
+	return ret;
+}
+
+static int ov13858_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13858 *ov13858 = to_ov13858(sd);
+
+	gpiod_set_value_cansleep(ov13858->reset_gpio, 1);
+	clk_disable_unprepare(ov13858->clk);
+	regulator_bulk_disable(ARRAY_SIZE(ov13858_supply_names),
+			       ov13858->supplies);
+
+	return 0;
+}
+
+static int ov13858_check_hwcfg(struct ov13858 *ov13858)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct device *dev = ov13858->dev;
+	struct fwnode_handle *ep;
+	unsigned int i;
+	int ret;
+
+	ov13858->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(ov13858->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov13858->reset_gpio),
+				     "getting reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(ov13858_supply_names); i++)
+		ov13858->supplies[i].supply = ov13858_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ov13858_supply_names),
+				      ov13858->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "getting regulators\n");
+
+	/* ACPI systems may have no graph: keep the old behaviour there */
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!ep)
+		return is_acpi_node(dev_fwnode(dev)) ? 0 :
+			dev_err_probe(dev, -EINVAL, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(dev, ret, "parsing endpoint failed\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 4) {
+		dev_err(dev, "number of CSI2 data lanes %u is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+	}
+
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
 /* Read registers up to 4 at a time */
 static int ov13858_read_reg(struct ov13858 *ov13858, u16 reg, u32 len,
 			    u32 *val)
@@ -1678,14 +1780,22 @@ static int ov13858_probe(struct i2c_client *client)
 				     "external clock %lu is not supported\n",
 				     freq);
 
+	ret = ov13858_check_hwcfg(ov13858);
+	if (ret)
+		return ret;
+
 	/* Initialize subdev */
 	v4l2_i2c_subdev_init(&ov13858->sd, client, &ov13858_subdev_ops);
 
+	ret = ov13858_power_on(ov13858->dev);
+	if (ret)
+		return ret;
+
 	/* Check module identity */
 	ret = ov13858_identify_module(ov13858);
 	if (ret) {
 		dev_err(ov13858->dev, "failed to find sensor: %d\n", ret);
-		return ret;
+		goto probe_power_off;
 	}
 
 	/* Set default mode to max resolution */
@@ -1693,7 +1803,7 @@ static int ov13858_probe(struct i2c_client *client)
 
 	ret = ov13858_init_controls(ov13858);
 	if (ret)
-		return ret;
+		goto probe_power_off;
 
 	/* Initialize subdev */
 	ov13858->sd.internal_ops = &ov13858_internal_ops;
@@ -1715,7 +1825,7 @@ static int ov13858_probe(struct i2c_client *client)
 		goto error_media_entity;
 
 	/*
-	 * Device is already turned on by i2c-core with ACPI domain PM.
+	 * Device is powered on (by i2c-core with ACPI domain PM, or above).
 	 * Enable runtime PM and turn off the device.
 	 */
 	pm_runtime_set_active(ov13858->dev);
@@ -1731,6 +1841,9 @@ static int ov13858_probe(struct i2c_client *client)
 	ov13858_free_controls(ov13858);
 	dev_err(ov13858->dev, "%s failed:%d\n", __func__, ret);
 
+probe_power_off:
+	ov13858_power_off(ov13858->dev);
+
 	return ret;
 }
 
@@ -1744,8 +1857,14 @@ static void ov13858_remove(struct i2c_client *client)
 	ov13858_free_controls(ov13858);
 
 	pm_runtime_disable(ov13858->dev);
+	if (!pm_runtime_status_suspended(ov13858->dev))
+		ov13858_power_off(ov13858->dev);
+	pm_runtime_set_suspended(ov13858->dev);
 }
 
+static DEFINE_RUNTIME_DEV_PM_OPS(ov13858_pm_ops, ov13858_power_off,
+				 ov13858_power_on, NULL);
+
 static const struct i2c_device_id ov13858_id_table[] = {
 	{ .name = "ov13858" },
 	{ }
@@ -1762,10 +1881,18 @@ static const struct acpi_device_id ov13858_acpi_ids[] = {
 MODULE_DEVICE_TABLE(acpi, ov13858_acpi_ids);
 #endif
 
+static const struct of_device_id ov13858_of_match[] = {
+	{ .compatible = "ovti,ov13858" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov13858_of_match);
+
 static struct i2c_driver ov13858_i2c_driver = {
 	.driver = {
 		.name = "ov13858",
 		.acpi_match_table = ACPI_PTR(ov13858_acpi_ids),
+		.of_match_table = ov13858_of_match,
+		.pm = pm_sleep_ptr(&ov13858_pm_ops),
 	},
 	.probe = ov13858_probe,
 	.remove = ov13858_remove,
-- 
2.43.0

