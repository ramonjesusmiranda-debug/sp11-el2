From 328719f17ac5aa547eafcf8081e0cc84d4273a38 Mon Sep 17 00:00:00 2001
From: Anthony Ruhier <aruhier@mailbox.org>
Date: Mon, 19 Oct 2026 01:31:16 +0200
Subject: [PATCH] PCI: Add quirk for wcn7850 [17cb:1107]

With LTR enabled, the card never goes to L1.2.
It looks like the firmware tries to avoid going to L1.2 by taking the
LTR_L1.2_THRESHOLD set at boot and set its threshold slightly below.

Windows on the Yoga Slim 7x (Qualcomm arm64 X1E) seems to workaround it
by never enabling the LTR bit. The card then ignores the ceiling and
enters in L1.2.
---
 drivers/pci/quirks.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/pci/quirks.c b/drivers/pci/quirks.c
index 1aa87a3ef9ede..d65cc084330aa 100644
--- a/drivers/pci/quirks.c
+++ b/drivers/pci/quirks.c
@@ -3795,6 +3795,23 @@ DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_QCOM, 0x1103, quirk_no_bus_reset); /* WCN
 DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_QCOM, 0x1107, quirk_no_bus_reset); /* WCN7850 */
 DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_QCOM, 0x0308, quirk_no_bus_reset); /* SDX62/SDX65 */
 
+/*
+ * The WCN7850 firmware reports an LTR just below the
+ * LTR_L1.2_THRESHOLD it sees at boot, preventing it to ever enter L1.2.
+ * With LTR disabled the link idles in L1.2, which is likely what Windows does
+ * (its _OSC never grants LTR control).
+ * Disable LTR.
+ */
+static void quirk_wcn7850_disable_ltr(struct pci_dev *pdev)
+{
+	pcie_capability_clear_word(pdev, PCI_EXP_DEVCTL2,
+				   PCI_EXP_DEVCTL2_LTR_EN);
+	pci_info(pdev, "LTR disabled to allow L1.2\n");
+}
+DECLARE_PCI_FIXUP_FINAL(PCI_VENDOR_ID_QCOM, 0x1107, quirk_wcn7850_disable_ltr);
+DECLARE_PCI_FIXUP_RESUME_EARLY(PCI_VENDOR_ID_QCOM, 0x1107,
+			       quirk_wcn7850_disable_ltr);
+
 /*
  * Root port on some Cavium CN8xxx chips do not successfully complete a bus
  * reset when used with certain child devices.  After the reset, config
