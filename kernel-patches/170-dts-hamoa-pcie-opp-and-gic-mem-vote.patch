From: Val Packett <val@packett.cool>
Subject: [PATCH] arm64: dts: qcom: hamoa: add OPP tables and GIC-to-DDR vote on pcie4/5/6a

Combines Val Packett's operating-points-v2 tables for pcie4/5/6a (lowering
required-opps from rpmhpd_opp_nom to low_svs/svs) with Anthony Ruhier's
gic-mem interconnect path (MASTER_GIC1 -> SLAVE_EBI1, 1 kB/s ALWAYS vote)
on pcie4 and pcie6a so BCM SN0 stays alive in the RPMh sleep set when all
USB controllers are runtime suspended and PCIe MSIs arrive via GIC ITS.
Keep pcie-mem peak vote at 250 MB/s (Gen1 x1, matching patch 09) so DDR
idles at 547 MHz while LLCC->DDR bwmon + scmi_memlat scale DDR on traffic.

---
--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi	2026-10-23 00:10:21.373726876 +0200
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi	2026-10-23 00:10:21.383726322 +0200
@@ -3560,9 +3560,12 @@
 			interconnects = <&pcie_south_anoc MASTER_PCIE_6A QCOM_ICC_TAG_ALWAYS
 					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
 					<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
-					 &cnoc_main SLAVE_PCIE_6A QCOM_ICC_TAG_ACTIVE_ONLY>;
+					 &cnoc_main SLAVE_PCIE_6A QCOM_ICC_TAG_ACTIVE_ONLY>,
+					<&system_noc MASTER_GIC1 QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
 			interconnect-names = "pcie-mem",
-					     "cpu-pcie";
+					     "cpu-pcie",
+					     "gic-mem";
 
 			resets = <&gcc GCC_PCIE_6A_BCR>,
 				 <&gcc GCC_PCIE_6A_LINK_DOWN_BCR>;
@@ -3570,13 +3573,114 @@
 				      "link_down";
 
 			power-domains = <&gcc GCC_PCIE_6A_GDSC>;
-			required-opps = <&rpmhpd_opp_nom>;
 
 			eq-presets-8gts = /bits/ 16 <0x5555 0x5555 0x5555 0x5555>;
 			eq-presets-16gts = /bits/ 8 <0x55 0x55 0x55 0x55>;
 
+			operating-points-v2 = <&pcie6a_opp_table>;
+
 			status = "disabled";
 
+			pcie6a_opp_table: opp-table {
+				compatible = "operating-points-v2";
+
+				/* 2.5GT/s x1 */
+				opp-2500000-1 {
+					opp-hz = /bits/ 64 <2500000>;
+					required-opps = <&rpmhpd_opp_low_svs>;
+					opp-peak-kBps = <250000 1 1>;
+					opp-level = <1>;
+				};
