 }
 
+static void iris_fw_iommu_unmap(struct iris_core *core)
+{
+	struct iommu_domain *domain;
+
+	if (!core->fw_dev || !core->pas_ctx)
+		return;
+
+	domain = iommu_get_domain_for_dev(core->fw_dev);
+	if (domain)
+		iommu_unmap(domain, IRIS_FIRMWARE_START_ADDR, core->pas_ctx->mem_size);
+}
+
+/* SMC SiP de 1 argumento (servicio/orden en «cmd»), como FUN_14000a780 de QcSkExt */
+static long el2_smc1(u32 cmd, u32 arg, unsigned long *r1)
+{
+	struct arm_smccc_quirk quirk = { .id = ARM_SMCCC_QUIRK_QCOM_A6 };
+	struct arm_smccc_res res;
+	unsigned long a0 = ARM_SMCCC_CALL_VAL(ARM_SMCCC_STD_CALL, ARM_SMCCC_SMC_64,
+					      ARM_SMCCC_OWNER_SIP, cmd);
+	int n = 0;
+
+	quirk.state.a6 = 0;
+	do {
+		arm_smccc_smc_quirk(a0, 1, arg, 0, 0, 0, quirk.state.a6, 0, &res, &quirk);
+		if (res.a0 == 1)
+			a0 = res.a0;
+	} while (res.a0 == 1 && ++n < 1000);
+	*r1 = res.a1;
+	return (long)res.a0;
+}
+
+/*
+ * Arranque del VPU en EL2, como QcSkExt8380 (VTL1 de Windows, FUN_14000ba78 -> b968 -> d7a0).
+ * Bajo Hyper-V la CSRT manda MEM_PROTECT_VIDEO_VAR (0x42000c08) y SET_REMOTE_STATE (0x4200010a)
+ * a SKExt, no a TZ: TZ autentica la imagen pero deja la CPU del VPU en reset. SKExt programa
+ * las ventanas de firmware/CP/no-pixel y los SID seguros y suelta el reset; aquí igual.
+ */
+static int iris_el2_vpu_boot(struct iris_core *core, const struct tz_cp_config *cp_config)
+{
+	void __iomem *b = core->reg_base;
+	u32 ver = readl(b + 0xb0000), fuses = 0;
+	u32 fwend = ALIGN(core->pas_ctx->mem_size, SZ_4K);
+	static const u32 sid0[] = { 0xc2090, 0xc2040, 0xc2044, 0xc2048, 0xc204c, 0xc2050,
+		0xc2054, 0xc2058, 0xc205c, 0xc2060, 0xc2064, 0xc2068, 0xc206c, 0xc2070,
+		0xc2074, 0xc2078, 0xc207c, 0xc2080 };
+	static const u32 cfg[][2] = { { 0xb1084, 1 }, { 0xc2024, 3 }, { 0xc2004, 0x540 },
+		{ 0xc2008, 0x10e }, { 0xc202c, 0x500 }, { 0xc2018, 0xed8 }, { 0xc201c, 0x3138 } };
+	static const u32 sid1[] = { 0xc2044, 0xc205c, 0xc207c, 0xc2070, 0xc2074, 0xc2078 };
+	static const u32 fbits[][2] = { { 0xd, 6 }, { 0xe, 0x18 }, { 0x10, 0x20 }, { 0xf, 0x40 } };
+	int k;
+
+	if (!(readl(b + 0xc1000) & 1)) {
+		dev_err(core->dev, "el2: VPU not in reset (%#x)\n", readl(b + 0xc1000));
+		return -EIO;
+	}
+	/* b968 */
+	writel(0, b + 0xc1028);
+	writel(fwend, b + 0xc102c);
+	writel(cp_config->cp_start, b + 0xc1020);
+	writel(cp_config->cp_size, b + 0xc1024);
+	if (ver >= 0x10020000) {
+		writel(cp_config->cp_nonpixel_start, b + 0xc1030);
+		writel(cp_config->cp_nonpixel_start + cp_config->cp_nonpixel_size, b + 0xc1034);
+	}
+	/* d7a0 */
+	for (k = 0; k < ARRAY_SIZE(sid0); k++)
+		writel(0, b + sid0[k]);
+	for (k = 0; k < ARRAY_SIZE(cfg); k++)
+		writel(cfg[k][1], b + cfg[k][0]);
+	for (k = 0; k < ARRAY_SIZE(sid1); k++) {
+		writel(readl(b + sid1[k]) | 1, b + sid1[k]);
+		if (!(readl(b + sid1[k]) & 1))
+			dev_err(core->dev, "el2: SEC_SID %#x did not latch\n", sid1[k]);
+	}
+	for (k = 0; k < ARRAY_SIZE(fbits); k++) {
+		unsigned long v = 0;
+		long st = el2_smc1(0x0802, fbits[k][0], &v);
+
+		if (st || v)
+			fuses |= fbits[k][1];
+	}
+	writel(fuses ? fuses | 1 : 0, b + 0xb108c);
+	/* ba78: soltar el reset de la CPU del VPU */
+	writel(readl(b + 0xc1000) & ~1u, b + 0xc1000);
+	dev_dbg(core->dev, "el2 boot: ver %#x reset %#x fw %#x-%#x cpa %#x-%#x np %#x-%#x fus %#x\n",
+		 ver, readl(b + 0xc1000), readl(b + 0xc1028), readl(b + 0xc102c),
+		 readl(b + 0xc1020), readl(b + 0xc1024), readl(b + 0xc1030),
+		 readl(b + 0xc1034), readl(b + 0xb108c));
+	return 0;
+}
+
 int iris_fw_load(struct iris_core *core)
 {
 	const struct tz_cp_config *cp_config;
@@ -76,38 +193,65 @@
 
 	ret = iris_load_fw_to_memory(core, fwpath);
 	if (ret) {
-		dev_err(core->dev, "firmware download failed\n");
+		dev_err(core->dev, "firmware download failed: %d\n", ret);
 		return -ENOMEM;
 	}
 
-	ret = qcom_scm_pas_auth_and_reset(IRIS_PAS_ID);
-	if (ret)  {
+	ret = qcom_scm_pas_prepare_and_auth_reset(core->pas_ctx);
+	if (ret) {
 		dev_err(core->dev, "auth and reset failed: %d\n", ret);
-		return ret;
+		goto err_unmap;
 	}
 
-	for (i = 0; i < core->iris_platform_data->tz_cp_config_data_size; i++) {
-		cp_config = &core->iris_platform_data->tz_cp_config_data[i];
-		ret = qcom_scm_mem_protect_video_var(cp_config->cp_start,
-						     cp_config->cp_size,
-						     cp_config->cp_nonpixel_start,
-						     cp_config->cp_nonpixel_size);
-		if (ret) {
-			dev_err(core->dev, "qcom_scm_mem_protect_video_var failed: %d\n", ret);
-			qcom_scm_pas_shutdown(IRIS_PAS_ID);
-			return ret;
+	if (core->pas_ctx->use_tzmem) {
+		/* EL2: VIDEO_VAR no llega a TZ (en Windows la atiende SKExt) */
+		for (i = 0; i < core->iris_platform_data->tz_cp_config_data_size; i++) {
+			cp_config = &core->iris_platform_data->tz_cp_config_data[i];
+			ret = iris_el2_vpu_boot(core, cp_config);
+			if (ret)
+				goto err_pas_shutdown;
+		}
+	} else {
+		for (i = 0; i < core->iris_platform_data->tz_cp_config_data_size; i++) {
+			cp_config = &core->iris_platform_data->tz_cp_config_data[i];
+			ret = qcom_scm_mem_protect_video_var(cp_config->cp_start,
+							     cp_config->cp_size,
+							     cp_config->cp_nonpixel_start,
+							     cp_config->cp_nonpixel_size);
+			if (ret) {
+				dev_err(core->dev, "qcom_scm_mem_protect_video_var failed: %d\n", ret);
+				goto err_pas_shutdown;
+			}
 		}
 	}
 
+	return 0;
+
+err_pas_shutdown:
+	qcom_scm_pas_shutdown(IRIS_PAS_ID);
+err_unmap:
+	iris_fw_iommu_unmap(core);
+
 	return ret;
 }
 
 int iris_fw_unload(struct iris_core *core)
 {
-	return qcom_scm_pas_shutdown(IRIS_PAS_ID);
+	int ret;
+
+	ret = qcom_scm_pas_shutdown(IRIS_PAS_ID);
+	iris_fw_iommu_unmap(core);
+
+	return ret;
 }
 
 int iris_set_hw_state(struct iris_core *core, bool resume)
 {
+	/* EL2: como SKExt (FUN_14000bde0), suspender no hace nada y reanudar repite el arranque */
+	if (core->pas_ctx && core->pas_ctx->use_tzmem) {
+		if (!resume)
+			return 0;
+		return iris_el2_vpu_boot(core, &core->iris_platform_data->tz_cp_config_data[0]);
+	}
 	return qcom_scm_set_remote_state(resume, 0);
 }
