--- a/drivers/media/platform/qcom/iris/iris_firmware.c	2026-10-25 07:27:00.098330327 +0000
+++ b/drivers/media/platform/qcom/iris/iris_firmware.c	2026-10-25 07:27:00.099156604 +0000
@@ -3,8 +3,10 @@
