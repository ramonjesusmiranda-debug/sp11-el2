+static int vd55g0_update_patgen(struct vd55g1 *sensor, u32 patgen_index)
+{
+	/* Valores de testPatternData de Windows: 0x0001, 0x0081, 0x0101 */
+	static const u16 index2val[] = { 0x0000, 0x0081, 0x0101 };
+
+	BUILD_BUG_ON(ARRAY_SIZE(index2val) != ARRAY_SIZE(vd55g1_tp_menu));
+
+	return vd55g1_write(sensor, VD55G0_REG_PATGEN_CTRL,
+			    index2val[patgen_index], NULL);
+}
+
+static int vd55g0_update_expo_cluster(struct vd55g1 *sensor, bool is_auto)
+{
+	int ret = 0;
+
+	/* Windows agrupa los cambios de exposición con 0x0448 = 1 ... 0 */
+	vd55g1_write(sensor, VD55G0_REG_GROUP_HOLD, 1, &ret);
+	vd55g1_write(sensor, VD55G0_REG_EXP_MODE,
+		     is_auto ? VD55G1_EXP_AUTO : VD55G1_EXP_MANUAL, &ret);
+	if (!is_auto) {
+		vd55g1_write(sensor, VD55G0_REG_MANUAL_COARSE_EXPOSURE,
+			     sensor->expo_ctrl->val, &ret);
+		vd55g1_write(sensor, VD55G0_REG_MANUAL_ANALOG_GAIN,
+			     sensor->again_ctrl->val, &ret);
+		vd55g1_write(sensor, VD55G0_REG_MANUAL_DIGITAL_GAIN,
+			     sensor->dgain_ctrl->val, &ret);
+	}
+	vd55g1_write(sensor, VD55G0_REG_GROUP_HOLD, 0, &ret);
+
+	return ret;
+}
+
+static int vd55g0_configure(struct vd55g1 *sensor,
+			    struct v4l2_mbus_framefmt *format)
+{
+	int ret = 0;
+
+	/* Windows deja el formato por defecto (RAW10, DT 0x2b); aquí, el pedido */
+	vd55g1_write(sensor, VD55G1_REG_MIPI_DATA_RATE, sensor->mipi_rate,
+		     &ret);
+	vd55g1_write(sensor, VD55G1_REG_OIF_CTRL, sensor->oif_ctrl, &ret);
+	vd55g1_write(sensor, VD55G1_REG_FORMAT_CTRL,
+		     vd55g1_get_fmt_bpp(format->code), &ret);
+	vd55g1_write(sensor, VD55G1_REG_OIF_IMG_CTRL,
+		     vd55g1_get_fmt_data_type(format->code), &ret);
+	cci_multi_reg_write(sensor->regmap, vd55g0_init_regs,
+			    ARRAY_SIZE(vd55g0_init_regs), &ret);
+
+	return ret;
+}
