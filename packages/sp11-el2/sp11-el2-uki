#!/bin/bash
# Construye /boot/sl/el2.efi (Surface Pro 11 en EL2 vía slbounce): kernel linux-sp11-el2, su initramfs propio
# (/etc/mkinitcpio-el2.conf) y el DTB EL2 del kernel con los overlays de /usr/share/sp11-el2. 17-10-2026
set -euo pipefail
pkgbase=linux-sp11-el2 esp=/boot
kver=
for f in /usr/lib/modules/*/pkgbase; do [[ -r $f && $(<"$f") == "$pkgbase" ]] && { kver=${f%/pkgbase}; kver=${kver##*/}; }; done
[[ -n $kver ]] || { echo "sp11-el2-uki: $pkgbase no está instalado"; exit 0; }
base=/usr/lib/modules/$kver/dtb/qcom/x1e80100-microsoft-denali-oled-el2.dtb
initrd=$esp/initramfs-$pkgbase.img
# El initramfs EL2 lleva el1tmr (DKMS): se rehace aquí para que siempre incluya el módulo recién compilado
mkinitcpio -p "$pkgbase" >/dev/null
[[ -e $base && -e $initrd ]] || { echo "sp11-el2-uki: falta $base o $initrd" >&2; exit 1; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
O=/usr/share/sp11-el2
cmd="$(tr -s '\n' ' ' </etc/kernel/cmdline) mem_sleep_default=s2idle fw_devlink.sync_state=timeout irqchip.gicv3_pseudo_nmi=1 pcie_port_pm=force msm.psr_enabled=1"
[[ -r /etc/kernel/cmdline-el2.extra ]] && cmd="$cmd $({ grep -v '^#' /etc/kernel/cmdline-el2.extra || true; } | tr -s '\n' ' ')"
install -d "$esp/sl"
uki() {	# $1 = nombre, $2 = título, resto = overlays
	local name=$1 title=$2; shift 2
	local ovs=(); for o in "$@"; do ovs+=("$O/$o.dtbo"); done
	fdtoverlay -i "$base" -o "$tmp/$name.dtb" "${ovs[@]}"
	echo "Construyendo $esp/sl/$name.efi ($kver)"
	ukify build --uname="$kver" --linux="/usr/lib/modules/$kver/vmlinuz" --initrd="$initrd" --devicetree="$tmp/$name.dtb" \
	  --cmdline="$cmd" --os-release=$'ID=arch\nPRETTY_NAME='"$title" --output="$esp/sl/$name.efi"
}
# Diario: ADSP de la UEFI enganchado, CDSP fuera, sin SS1, bit sleepstate al ADSP, CL5 solo al dormir
uki el2 "Arch Linux EL2 sin DSP (Surface Pro 11)" sp11-el2-adsp-adjunto sp11-el2-fase2 sp11-el2-sin-ss1 sp11-el2-sleepstate sp11-el2-cl5-solo-suspension
# Principal: ADSP y CDSP arrancados por Linux (x1e-dsp): audio, NPU, cxsd+aosd con el parche 140
uki el2-dsp "Arch Linux EL2 (Surface Pro 11)" sp11-el2-sin-ss1 sp11-el2-sleepstate sp11-el2-cl5-solo-suspension
